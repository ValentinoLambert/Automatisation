<?xml version="1.0"?>
<ruleset name="Custom Standard">
    <description>Custom standard based on PSR12 with 4 space indentation.</description>
    <rule ref="PSR12"/>
    <file>src</file>
    <arg name="colors"/>
    <arg value="p"/>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
        </properties>
    </rule>
</ruleset>
